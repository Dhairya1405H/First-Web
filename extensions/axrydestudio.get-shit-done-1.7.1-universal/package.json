			]
		},
		"views": {
			"gsdContainer": [
				{
					"type": "webview",
					"id": "gsd.missionControl",
					"name": "Mission Control"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "gsd.refresh",
					"when": "view == gsd.missionControl",
					"group": "navigation"
				}
			]
		}
