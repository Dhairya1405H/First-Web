# EcoQuest Environment Configuration

# Client-side variables (Prefixed with VITE_)
VITE_API_URL=/api
VITE_APP_ENV=development

# Supabase Client Configuration (Safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-side Secrets (NEVER expose to frontend code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
JWT_SECRET=ecoquest-secure-jwt-secret-key-change-in-production-2026
PORT=3000
